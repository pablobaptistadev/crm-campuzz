{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campuzz-e2e-prod",
  "main": "src/index.ts",
  "account_id": "ddfef995177f50ca821fcfdc4a4deefe",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Test code lives in its own Worker so it never ships inside the API.
  "browser": { "binding": "BROWSER" },

  // Screenshots are written here so a failed run leaves evidence behind.
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "campuzz-files-prod" }],

  "vars": {
    "TARGET_URL": "https://crm.campuzz.com.br",
    "TEST_EMAIL": "contato@pablobaptista.com.br"
  }
}
